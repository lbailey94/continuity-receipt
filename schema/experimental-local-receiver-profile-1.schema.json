{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://continuity-receipt.org/schema/experimental-local-receiver-profile-1.schema.json",
  "title": "Experimental local receiver profile v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["kind", "version", "id", "export", "trust", "authority", "consent", "retention", "refusal"],
  "properties": {
    "kind": {"const": "cpr-experimental-local-receiver-profile"},
    "version": {"const": 1},
    "id": {"type": "string", "minLength": 1},
    "export": {
      "type": "object", "additionalProperties": false,
      "required": ["scope", "inventory", "optional", "memory_paths"],
      "properties": {
        "scope": {"type": "string", "minLength": 1},
        "inventory": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "string", "minLength": 1}},
        "optional": {"type": "array", "uniqueItems": true, "items": {"type": "string", "minLength": 1}},
        "memory_paths": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "string", "minLength": 1}}
      }
    },
    "trust": {
      "type": "object", "additionalProperties": false,
      "required": ["context", "key_sha256", "reference", "clock"],
      "properties": {
        "context": {"type": "string", "minLength": 1},
        "key_sha256": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"},
        "reference": {"const": "receiver-trust-db/current_reference; advanced only by explicit local publish"},
        "clock": {"const": "system-utc"}
      }
    },
    "authority": {"const": {"status": "operator-asserted", "basis": "outside this verifier"}},
    "consent": {"const": {"status": "operator-asserted", "subject_consent_verified": false}},
    "retention": {"const": {"mode": "retain current generation until explicit replacement; prior generations may remain on disk", "deletion": "operator-managed"}},
    "refusal": {"const": ["missing policy or reference", "untrusted or stale evidence", "inventory mismatch", "selected memory file missing or invalid UTF-8"]}
  }
}
