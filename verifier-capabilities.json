{
  "kind": "continuity-receipt-verifier-capabilities",
  "version": 1,
  "implementation": "continuity-receipt (Python reference)",
  "spec_versions": [
    "continuity-receipt/0.1",
    "continuity-receipt/0.2",
    "continuity-receipt/0.3",
    "continuity-receipt/0.4",
    "continuity-receipt/0.5"
  ],
  "verdicts": [
    "TRUSTED",
    "PROVISIONAL",
    "INSUFFICIENT_EVIDENCE",
    "UNTRUSTED"
  ],
  "checks": [
    "envelope_schema",
    "chain",
    "signatures",
    "counterparty_attestations",
    "cross_record",
    "agreement_binding",
    "revocations",
    "anchors",
    "redactions_erasure"
  ],
  "error_codes": [
    "malformed",
    "unknown_type",
    "bad_signature",
    "chain_break",
    "task_mismatch",
    "policy_mismatch",
    "cap_exceeded",
    "delivery_before_settlement",
    "missing_termination",
    "anchor_invalid",
    "redacted_required",
    "commit_mismatch",
    "version_unsupported",
    "bad_attestation",
    "bad_revocation",
    "key_revoked",
    "provenance_invalid",
    "offer_mismatch",
    "offer_expired",
    "offeree_mismatch",
    "accept_before_offer",
    "agreement_before_accept",
    "agreement_issuer_mismatch",
    "too_many_receipts",
    "nesting_too_deep",
    "bundle_too_large"
  ],
  "provisional_reasons": [
    "anchor_missing",
    "redacted_without_disclosure:<path>",
    "agreement_unreferenced:<path>",
    "missing_agreement_ref:<path>"
  ],
  "insufficient_reasons": [
    "erased_content:<path>",
    "missing_offer:<receipt_id>",
    "missing_agreement:<receipt_id>"
  ],
  "revocation_lists": {
    "supported": true,
    "document_kind": "continuity-receipt-revocations",
    "document_version": 1,
    "channel_authenticity": "per-statement self-signature",
    "deduplicated_with_bundle": true,
    "https_required": true,
    "loopback_http_allowed": true,
    "max_document_bytes": 1048576,
    "error_codes": [
      "bad_revocations_document",
      "revocations_unreachable",
      "revocations_insecure_url",
      "revocations_too_large"
    ]
  },
  "anchors": {
    "bundle_binding": "digest",
    "types": [
      "opentimestamps",
      "public-chain",
      "custom"
    ],
    "proof_verification": "companion",
    "companion_cli": "continuity-receipt-anchor",
    "proof_formats": [
      "opentimestamps-detached"
    ],
    "header_chain_validation": false,
    "litecoin_header_check": false,
    "unsupported_ops": [
      "keccak256"
    ]
  },
  "cli": {
    "verify": "continuity-receipt-verify",
    "disclose": "continuity-receipt-disclose",
    "anchor": "continuity-receipt-anchor",
    "verify_receipt": "continuity-receipt-verify-receipt"
  },
  "verification_receipts": {
    "supported": true,
    "kind": "continuity-receipt-verification",
    "version": 1,
    "document": "VERIFICATION_RECEIPTS.md",
    "schema": "schema/verification-receipt-1.schema.json",
    "vectors": "vectors/verification/manifest.json",
    "digest_rule": "sha256 of the JCS-canonical bytes of the verified bundle object",
    "records": [
      "verdict",
      "error_codes",
      "errors",
      "provisional_reasons",
      "insufficient_reasons",
      "summary"
    ],
    "consistency_checks": [
      "error_codes equals the codes in errors (in order)",
      "verdict equals the class implied by errors/provisional_reasons/insufficient_reasons"
    ],
    "revocation_check": "opt-in input (statements); without it the check is not performed",
    "error_codes": [
      "not_an_object",
      "bad_kind",
      "bad_version",
      "bad_verdict",
      "bad_verified_at",
      "bad_bundle_digest",
      "bad_error_codes",
      "bad_errors",
      "bad_provisional_reasons",
      "bad_insufficient_reasons",
      "bad_summary",
      "error_codes_mismatch",
      "verdict_mismatch",
      "bad_signature_shape",
      "bad_signature",
      "bundle_digest_mismatch",
      "key_revoked"
    ]
  },
  "out_of_scope": [
    "issuer honesty",
    "proof-of-work and header-chain validation",
    "revocation-list freshness guarantees (withholding)",
    "CBOR encoding profile",
    "HMAC commitments and domain separation",
    "succession multi-signatures",
    "global revocation roots",
    "selective disclosure beyond per-field salts"
  ]
}
